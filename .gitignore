# ---------- 后端 ----------
node_modules/
backend/data/
*.db
*.db-wal
*.db-shm
.env

# ---------- Flutter ----------
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/build/

# 注意：app/pubspec.lock **故意不忽略**，要提交上去。
# 它锁定每个依赖的确切版本。App 是"应用"不是"库"，提交它才能保证
# 你本机、GitHub Actions、别人 clone 下来装到的是同一套版本 ——
# 否则某天 http 包发新版改了行为，你的构建忽然就红了，
# 而你什么都没改，会查得很痛苦。
# （写库的时候反过来：不提交 lock，否则会把版本强加给使用者。）

# Android
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/android/app/*.jks
app/android/app/*.keystore

# iOS
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh

# 插件自动生成的注册代码
app/**/GeneratedPluginRegistrant.*

# ---------- 原生双端（native/）----------
native/android/.gradle/
native/android/build/
native/android/app/build/
native/android/local.properties
native/ios/build/
native/ios/DerivedData/
native/ios/*.xcodeproj/
native/ios/Info.plist

# ---------- Cloudflare Workers + D1 ----------
# 真实 database_id 和演示数据由部署脚本生成，不提交。
worker/wrangler.generated.toml
worker/seed.generated.sql
worker/.wrangler/
.wrangler/

# ---------- 一键交付（scripts/deploy.mjs）----------
# secrets/ 里放的是 GitHub 令牌（secrets/token.txt），**绝对不能提交**。
# 它等价于你 GitHub 账号的写权限：谁拿到谁就能往你仓库里推代码、
# 也能读你的私有仓库。一旦进了公开仓库的历史，就算删掉也还能被翻出来。
secrets/

# dist/ 是下载下来的录屏和截图（几十 MB 的 mp4）。
# 它是"产物"不是"源码"，每次跑都能重新生成，没有版本控制的意义。
dist/

# CI 构建时复制到仓库根目录的 APK（正常版 + 录屏演示版）。
moneynote-*.apk

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
*.iml
.classpath
.project
.settings/
.DS_Store
Thumbs.db
